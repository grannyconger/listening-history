{
  "_help": "Rules that mark plays as NOT personal listening. 'enabled' sets the site default (each rule can also be toggled in the site's Exclusions panel). Match on 'artists' (exact names), 'track_regex', 'album_regex', 'show_regex' (case-insensitive Python regex). Optional 'when' limits the rule to local weekdays (0=Mon..6=Sun) and a start/end time window. Re-run scripts/build_data.py after editing. A rule with \"type\": \"overnight\" ignores names and instead marks songs that played on their own after you stopped touching Spotify late at night, until your first touch the next morning (see params). A rule with \"type\": \"wake_alarm\" marks only each day's first play after params.after when it matches a listed song within its from/to dates and was started remotely on a smart speaker (find candidates with scripts/find_alarms.py).",
  "rules": [
    {
      "id": "christian_artists",
      "label": "Christian artists",
      "short": "Christian",
      "group": "genre",
      "type": "artist_tag",
      "tag": "christian",
      "description": "Worship, gospel and Christian artists.",
      "enabled": true
    },
    {
      "id": "instrumental_artists",
      "label": "Instrumental artists",
      "short": "instrumental",
      "group": "genre",
      "type": "artist_tag",
      "tag": "instrumental",
      "description": "Artists whose music is mostly without singing: piano covers, classical, film scores, lo-fi and similar.",
      "enabled": true
    },
    {
      "id": "asleep_overnight",
      "label": "Playing while asleep",
      "description": "Songs that kept playing on their own after your last touch at night (no taps, skips or picks until the morning). Counts from 30 minutes after your last touch, between 11pm and 9am.",
      "enabled": true,
      "type": "overnight",
      "params": {
        "grace_minutes": 30,
        "counts_from": "23:00",
        "last_touch_before": "04:00",
        "next_touch_after": "05:00",
        "min_untouched_hours": 3,
        "stops_at": "09:00"
      }
    },
    {
      "id": "wake_alarm",
      "label": "Wake-up alarms",
      "description": "Songs an Alexa or Google Home routine played as a morning alarm: the alarm song (first play after 4am) and the routine's second song right after it. Other plays of the same songs still count.",
      "enabled": true,
      "type": "wake_alarm",
      "params": {
        "after": "04:00",
        "reasons": [
          "remote",
          "playbtn"
        ],
        "second_song_minutes": 30
      },
