  "components": [
    {
      "name": "Masthead",
      "kind": "nav",
      "refersTo": "masthead",
      "description": "Sticky navy band with slab gold brand and white tabs; active tab carries a 3px gold underline.",
      "html": "<header class=\"ds-mast\"><a class=\"ds-brand\" href=\"#\">Listening History</a><nav class=\"ds-nav\"><a class=\"on\" href=\"#\">Story</a><a href=\"#\">Eras</a><a href=\"#\">Rediscover</a><a href=\"#\">Explore</a></nav></header>",
      "css": ".ds-mast{display:flex;align-items:center;gap:28px;padding:14px 24px;background:var(--mast,#1d2a5b);color:var(--mast-ink,#fff);font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif}.ds-brand{font-family:\"Alfa Slab One\",Rockwell,serif;font-size:22px;color:var(--gold,#f2b632);text-decoration:none;white-space:nowrap}.ds-nav{display:flex;gap:22px}.ds-nav a{font-size:17px;font-weight:600;color:var(--mast-muted,#c3cbe6);padding:6px 0;border-bottom:3px solid transparent;text-decoration:none}.ds-nav a:hover{color:var(--mast-ink,#fff)}.ds-nav a.on{color:var(--mast-ink,#fff);border-bottom-color:var(--gold,#f2b632)}.ds-nav a:focus-visible,.ds-brand:focus-visible{outline:3px solid var(--gold,#f2b632);outline-offset:3px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Square navy slab; hover presses a 4px gold bar up from the bottom.",
      "html": "<button class=\"ds-btn\" type=\"button\">Play this year</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;font:600 17px/1.55 \"Atkinson Hyperlegible Next\",system-ui,sans-serif;border:0;border-radius:0;background:var(--navy,#1d2a5b);color:#fff;padding:10px 18px;cursor:pointer}.ds-btn:hover{box-shadow:inset 0 -4px 0 var(--gold,#f2b632)}.ds-btn:focus-visible{outline:3px solid var(--gold,#f2b632);outline-offset:3px}.ds-btn[disabled]{opacity:.55;cursor:default}"
    },
    {
      "name": "Text Button and Playlist Actions",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Plain navy words; playlist actions rest on a 2px gold underline that thickens to 4px.",
      "html": "<div class=\"ds-mix\"><button class=\"ds-act\" type=\"button\">Save as a playlist</button><button class=\"ds-ghost\" type=\"button\">Copy song list</button></div>",
      "css": ".ds-mix{display:flex;flex-wrap:wrap;gap:6px 22px;font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif}.ds-act,.ds-ghost{background:none;border:0;border-radius:0;font:inherit;cursor:pointer;padding:4px 0}.ds-act{color:var(--navy-ink,#1d2a5b);font-size:16px;font-weight:700;box-shadow:inset 0 -2px 0 var(--gold,#f2b632)}.ds-act:hover{box-shadow:inset 0 -4px 0 var(--gold,#f2b632)}.ds-ghost{color:var(--text-secondary,#4d4a45);font-size:16px;font-weight:600}.ds-ghost:hover{color:var(--ink,#16130f);text-decoration:underline;text-decoration-color:var(--gold,#f2b632);text-underline-offset:4px;text-decoration-thickness:2px}.ds-act:focus-visible,.ds-ghost:focus-visible{outline:3px solid var(--gold,#f2b632);outline-offset:3px}"
    },
    {
      "name": "Play Button",
      "kind": "button",
      "refersTo": "play-button",
      "description": "40px ringed circle that fills gold on hover.",
      "html": "<button class=\"ds-play\" type=\"button\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M8 5.5v13l11-6.5z\" fill=\"currentColor\"/></svg></button>",
      "css": ".ds-play{width:40px;height:40px;border:0;border-radius:50%;background:none;color:var(--navy-ink,#1d2a5b);display:grid;place-items:center;cursor:pointer;box-shadow:inset 0 0 0 2px var(--axis,#c9c4b8);transition:background .15s,box-shadow .15s,color .15s}.ds-play svg{margin-left:2px}.ds-play:hover{background:var(--gold,#f2b632);color:#16130f;box-shadow:none}.ds-play:focus-visible{outline:3px solid var(--gold,#f2b632);outline-offset:3px}"
    },
    {
      "name": "Year Picker",
      "kind": "chip",
      "refersTo": "picker-item",
      "description": "Plain year words, current year navy 800 with a 3px gold underline. Not pills.",
      "html": "<nav class=\"ds-picker\" aria-label=\"Year\"><button type=\"button\">All years</button><button type=\"button\">2019</button><button type=\"button\" class=\"on\">2020</button><button type=\"button\">2021</button></nav>",
      "css": ".ds-picker{display:flex;flex-wrap:wrap;gap:6px 22px;font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif}.ds-picker button{font:inherit;font-size:17px;background:none;border:0;border-bottom:3px solid transparent;padding:4px 0;color:var(--text-secondary,#4d4a45);cursor:pointer;font-variant-numeric:tabular-nums}.ds-picker button:hover{color:var(--ink,#16130f)}.ds-picker .on{color:var(--navy-ink,#1d2a5b);font-weight:800;border-bottom-color:var(--gold,#f2b632)}.ds-picker button:focus-visible{outline:3px solid var(--gold,#f2b632);outline-offset:3px}"
    },
    {
      "name": "Underline Input",
      "kind": "input",
      "refersTo": "input-underline",
      "description": "Borderless field on a 2px axis underline; focus swaps to a 3px gold underline.",
      "html": "<label class=\"ds-field\"><span>From artist</span><input class=\"ds-input\" placeholder=\"Type an artist\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif}.ds-field span{font-size:15px;font-weight:700;color:var(--text-secondary,#4d4a45)}.ds-input{font:inherit;font-size:17px;color:var(--ink,#16130f);background:var(--surface-1,#fff);border:0;border-radius:0;box-shadow:inset 0 -2px 0 var(--axis,#c9c4b8);padding:9px 4px;caret-color:var(--gold-ink,#8a5f00)}.ds-input:focus{outline:none;box-shadow:inset 0 -3px 0 var(--gold,#f2b632)}"
    },
    {
      "name": "Superlative",
      "kind": "custom",
      "refersTo": "superlative-label",
      "description": "112px square cover, navy slab label, big winning title, caption, play button; rows split by 2px gold rules.",
      "html": "<div class=\"ds-sups\"><div class=\"ds-sup\"><span class=\"ds-art\"></span><div><h4 class=\"ds-sup-l\">Most played</h4><p class=\"ds-sup-t\">Song title</p><p class=\"ds-sup-d\">Artist, 214 plays</p></div><button class=\"ds-play\" type=\"button\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M8 5.5v13l11-6.5z\" fill=\"currentColor\"/></svg></button></div><div class=\"ds-sup\"><span class=\"ds-art\"></span><div><h4 class=\"ds-sup-l\">Best newcomer</h4><p class=\"ds-sup-t\">Another song</p><p class=\"ds-sup-d\">New artist, 31 h in your first year</p></div><button class=\"ds-play\" type=\"button\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M8 5.5v13l11-6.5z\" fill=\"currentColor\"/></svg></button></div></div>",
      "css": ".ds-sups{font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif;color:var(--ink,#16130f)}.ds-sup{display:grid;grid-template-columns:112px minmax(0,1fr) auto;gap:20px;align-items:center;padding:18px 0;border-bottom:2px solid var(--gold,#f2b632)}.ds-sup:last-child{border-bottom:0}.ds-art{width:112px;height:112px;background:var(--paper-2,#f5f3ec);display:block}.ds-sup-l{margin:0;font:400 24px/1.1 \"Alfa Slab One\",Rockwell,serif;color:var(--navy-ink,#1d2a5b)}.ds-sup-t{margin:6px 0 0;font-size:19px;font-weight:800;line-height:1.2}.ds-sup-d{margin:2px 0 0;font-size:16px;color:var(--text-secondary,#4d4a45)}.ds-play{width:40px;height:40px;border:0;border-radius:50%;background:none;color:var(--navy-ink,#1d2a5b);display:grid;place-items:center;cursor:pointer;box-shadow:inset 0 0 0 2px var(--axis,#c9c4b8);transition:background .15s,box-shadow .15s}.ds-play:hover{background:var(--gold,#f2b632);color:#16130f;box-shadow:none}.ds-play:focus-visible{outline:3px solid var(--gold,#f2b632);outline-offset:3px}"
    },
    {
      "name": "Portrait Grid",
      "kind": "custom",
      "refersTo": "portrait",
      "description": "Unframed 4:5 artist portraits in a strict 4-column grid, captioned underneath.",
      "html": "<ul class=\"ds-port\"><li><figure><span class=\"ds-ph\">AB</span><figcaption><span class=\"t\">Artist One</span><span class=\"c\">212 h</span></figcaption></figure></li><li><figure><span class=\"ds-ph\">CD</span><figcaption><span class=\"t\">Artist Two</span><span class=\"c\">140 h</span></figcaption></figure></li><li><figure><span class=\"ds-ph\">EF</span><figcaption><span class=\"t\">Artist Three</span><span class=\"c\">96 h</span></figcaption></figure></li><li><figure><span class=\"ds-ph\">GH</span><figcaption><span class=\"t\">Artist Four</span><span class=\"c\">71 h</span></figcaption></figure></li></ul>",
      "css": ".ds-port{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px 18px;font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif}.ds-port figure{margin:0}.ds-ph{display:grid;place-items:center;width:100%;aspect-ratio:4/5;background:var(--paper-2,#f5f3ec);font:400 28px \"Alfa Slab One\",Rockwell,serif;color:var(--text-muted,#6e6a63)}.ds-port li:hover .ds-ph{filter:saturate(1.15) contrast(1.03)}.ds-port figcaption{margin-top:8px;font-size:15px;line-height:1.35}.ds-port .t{display:block;font-weight:800;color:var(--ink,#16130f)}.ds-port .c{display:block;color:var(--text-secondary,#4d4a45);margin-top:2px}"
    },
    {
      "name": "Cover Row with Now Playing",
      "kind": "custom",
      "refersTo": "cover-play-badge",
      "description": "Big 1:1 covers that lift on hover and reveal a gold play badge; the playing one wears the gold ring and a slab Now playing line.",
      "html": "<ul class=\"ds-covers\"><li><button class=\"ds-cover\" type=\"button\" aria-label=\"Play Song one\"><span class=\"ds-big\"></span><span class=\"ds-badge\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M8 5.5v13l11-6.5z\" fill=\"currentColor\"/></svg></span></button><span class=\"t\">Song one</span><span class=\"a\">Artist</span></li><li class=\"playing\"><button class=\"ds-cover\" type=\"button\" aria-label=\"Play Song two\"><span class=\"ds-big\"></span><span class=\"ds-badge\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M8 5.5v13l11-6.5z\" fill=\"currentColor\"/></svg></span></button><span class=\"t\">Song two</span><span class=\"a\">Artist<span class=\"ds-now\">Now playing</span></span></li></ul>",
      "css": ".ds-covers{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,180px));gap:24px 20px;font-family:\"Atkinson Hyperlegible Next\",system-ui,sans-serif}.ds-cover{position:relative;display:block;width:100%;padding:0;border:0;background:none;cursor:pointer}.ds-big{display:block;width:100%;aspect-ratio:1;background:var(--paper-2,#f5f3ec);transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s}.ds-badge{position:absolute;right:10px;bottom:10px;width:44px;height:44px;border-radius:50%;background:var(--gold,#f2b632);color:#16130f;display:grid;place-items:center;opacity:0;transform:translateY(6px);transition:opacity .18s,transform .18s cubic-bezier(.2,.8,.2,1)}.ds-cover:hover .ds-big,.ds-cover:focus-visible .ds-big{transform:translateY(-4px);box-shadow:var(--lift,0 2px 6px rgba(22,19,15,.08),0 18px 40px rgba(22,19,15,.16))}.ds-cover:hover .ds-badge,.ds-cover:focus-visible .ds-badge{opacity:1;transform:none}.ds-cover:focus-visible{outline:3px solid var(--gold,#f2b632);outline-offset:3px}.playing .ds-big{transform:translateY(-3px);box-shadow:var(--lift,0 2px 6px rgba(22,19,15,.08),0 18px 40px rgba(22,19,15,.16)),0 0 0 4px var(--gold,#f2b632)}.playing .ds-badge{opacity:1;transform:none}.ds-covers .t{display:block;font-weight:800;margin-top:10px;color:var(--ink,#16130f)}.ds-covers .a{display:block;font-size:15px;color:var(--text-secondary,#4d4a45)}.ds-now{display:block;margin-top:6px;font:400 15px \"Alfa Slab One\",Rockwell,serif;color:var(--gold-ink,#8a5f00)}"
    }
  ],
  "narrative": {
    "northStar": "The Music Yearbook",
    "overview": "**Creative North Star: \"The Music Yearbook\"**\n\nThe site is printed like a school yearbook: bright white paper, two school colors, near-black ink. Each year is a spread. A giant navy year numeral and a strict grid of artist portraits sit on the left, a thick gold gutter divides the page, and the right column lists the year's superlatives, each one a large square cover with a gold-edged slab label and the song title set big. Album covers and artist photos carry most of the color; navy and gold are the school colors that frame them.\n\nDensity is generous and calm. Sections breathe on a 96px chapter rhythm, type is large (18px body), and nothing is boxed. Separation comes from space, from portraits sitting in their grid, and from gold rules. Depth appears only when something is picked up: a cover lifts on hover, a playing song lifts and wears a gold ring with a slab \"Now playing\" line under it. Motion steps into place and stops; nothing drifts.\n\nThe world rejects the streaming-app default: no Wrapped-style gradients, no black-and-green app look, no dashboard stat tiles, no cards or bordered boxes.",
    "keyCharacteristics": [
      "White yearbook paper with navy fields and headings and gold rules and labels.",
      "Collegiate slab (Alfa Slab One) for years, headings and superlative labels; Atkinson Hyperlegible Next for everything read.",
      "Portraits in 4:5, covers in 1:1, both square-cornered and unframed, captioned underneath.",
      "Gold rules are the only lines: a 6px gutter, 6px section rules, 2px superlative dividers, 3px underlines for the current tab.",
      "Lift-on-pick-up depth; flat at rest.",
      "A navy night edition (not black) for dark mode, with gold kept unchanged."
    ],
    "rules": [
      {
        "name": "The Two School Colors Rule",
        "body": "Navy and gold are the only chrome colors. Any other color on the page comes from album art, a photo, or a chart series that names one kind of listening.",
        "section": "colors"
      },
      {
        "name": "The Gold Is a Line Rule",
        "body": "Gold draws rules, underlines, rings and small fills. Text that must be read in gold uses Gold Ink, never School Gold on white.",
        "section": "colors"
      },
      {
        "name": "The Night Edition Rule",
        "body": "Dark mode is navy paper (night-page), never black, and never paired with green. Gold does not change between editions.",
        "section": "colors"
      },
      {
        "name": "The Shade Carries Data Rule",
        "body": "Light-to-dark shading appears only where it encodes a quantity (heatmaps, era lines). Nowhere else are colors faded or tinted.",
        "section": "colors"
      },
      {
        "name": "The Slab Stamps, Sans Speaks Rule",
        "body": "Slab is for years, headings, rank numbers and superlative labels. Sentences, captions and controls are always in Atkinson Hyperlegible Next.",
        "section": "typography"
      },
      {
        "name": "The Numbers Line Up Rule",
        "body": "Years, ranks, hours and table figures use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Picked Up Rule",
        "body": "Shadows appear only when something is lifted by the visitor or floats above the page. Nothing sits in a raised panel at rest.",
        "section": "elevation"
      },
      {
        "name": "The No Box Rule",
        "body": "No element is enclosed on all four sides by a border. Separation is space, a grid, or a single gold rule.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do open each year as a spread: slab year numeral, 4:5 portrait grid, 6px gold gutter, superlatives column.",
      "Do let album covers and artist photos carry the color, framed by navy and gold.",
      "Do separate with space and single gold rules (2px between rows, 3px for active underlines, 6px between major parts).",
      "Do use the Lift shadow only for hover, the playing item, and floating layers.",
      "Do move with cubic-bezier(.2, .8, .2, 1) at 150ms to 350ms, and drop all motion under prefers-reduced-motion.",
      "Do keep every corner square except the round play controls and toggle.",
      "Do use Gold Ink, not School Gold, for any gold text on white."
    ],
    "donts": [
      "Don't use gradients as color (the only linear-gradient is a solid gold bar drawn under page titles).",
      "Don't build a black-and-green app look; the night edition is navy.",
      "Don't make dashboard stat tiles; numbers go in sentences, captions and right-aligned list values.",
      "Don't enclose content in cards or four-sided bordered boxes.",
      "Don't add pills, tags or chips; pickers are plain words with a gold underline.",
      "Don't set sentences, captions or controls in the slab, or track the slab.",
      "Don't introduce a third chrome color; extra hues are reserved for chart series that each name one kind of listening."
    ]
  }
}
